{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyHighCostGPUInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "ec2:InstanceType": [
            "p2.*",
            "p3.*",
            "p4.*",
            "p5.*",
            "g3.*",
            "g4dn.*",
            "g5.*",
            "inf1.*",
            "trn1.*"
          ]
        },
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/LendFlowDataMLAdminRole",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    }
  ]
}
